{
  "manifest_version": 3,
  "name": "UniTrack",
  "version": "1.0.0",
  "description": "A privacy-first study companion that tracks assignment activity locally.",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
     "https://docs.google.com/*",
    "https://forms.google.com/*",
    "https://classroom.google.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/banner.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
    ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}